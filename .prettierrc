{
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "useTabs": false,
    "trailingComma": "all",
    "printWidth": 120,
    "arrowParens": "always",
    "endOfLine": "lf",
    "plugins": [
        "@shufo/prettier-plugin-blade",
        "prettier-plugin-tailwindcss"
    ],
    "overrides": [
        {
            "files": "*.blade.php",
            "options": {
                "parser": "blade",
                "wrapAttributes": "force-expand-multiline",
                "wrapLineLength": 120,
                "endWithNewline": true,
                "sortTailwindClasses": true,
                "noStructureSort": true,
                "noMultipleEmptyLines": true
            }
        }
    ]
}